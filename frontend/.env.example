# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND ENVIRONMENT VARIABLES
# ─────────────────────────────────────────────────────────────────────────────
# In Vite, all environment variables exposed to the client MUST start with VITE_

# URL of the deployed backend Express server (without trailing slash)
# Local: http://localhost:5000
# Production example: https://mafia-backend.onrender.com
VITE_BACKEND_URL=http://localhost:5000

# Base URL for API calls
# Optional: Defaults automatically to ${VITE_BACKEND_URL}/api
VITE_API_BASE_URL=http://localhost:5000/api

# WebSocket / Socket.IO Server URL
# Optional: Defaults automatically to ${VITE_BACKEND_URL}
VITE_SOCKET_URL=http://localhost:5000
